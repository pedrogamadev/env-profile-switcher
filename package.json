{
  "name": "semaforo-env",
  "displayName": "Semáforo Env",
  "description": "Troque de banco no .env com um clique, por grupos independentes, sem comentar linha na mão. Status bar verde, amarela ou vermelha conforme o ambiente ativo.",
  "version": "0.2.1",
  "publisher": "arabella-dev",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrogamadev/env-profile-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/pedrogamadev/env-profile-switcher/issues"
  },
  "homepage": "https://github.com/pedrogamadev/env-profile-switcher#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "env",
    "dotenv",
    ".env",
    "database",
    "profiles",
    "environment",
    "prisma",
    "switcher"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:**/.env",
    "workspaceContains:.env.example"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "semaforoEnv",
          "title": "Semáforo Env",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "semaforoEnv": [
        {
          "id": "semaforoEnv.view",
          "name": "Perfis"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "semaforoEnv.view",
        "contents": "Nenhum grupo encontrado no .env deste projeto.\nMarque os blocos com # @group, # @option (use @danger nos ambientes remotos) e # @end.\n[Abrir .env](command:semaforoEnv.openFile)\n[Escolher outro arquivo .env](command:semaforoEnv.pickFile)\n[Criar .env.example de exemplo](command:semaforoEnv.createExample)",
        "when": "semaforoEnv.fileExists"
      },
      {
        "view": "semaforoEnv.view",
        "contents": "Não encontrei o .env deste projeto.\nSe ele estiver em uma subpasta (monorepo), escolha qual arquivo controlar.\n[Escolher arquivo .env](command:semaforoEnv.pickFile)\n[Criar .env.example de exemplo](command:semaforoEnv.createExample)",
        "when": "!semaforoEnv.fileExists"
      }
    ],
    "commands": [
      {
        "command": "semaforoEnv.selectOption",
        "title": "Selecionar opção",
        "category": "Semáforo Env"
      },
      {
        "command": "semaforoEnv.quickSwitch",
        "title": "Trocar perfil",
        "category": "Semáforo Env",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "semaforoEnv.refresh",
        "title": "Atualizar",
        "category": "Semáforo Env",
        "icon": "$(refresh)"
      },
      {
        "command": "semaforoEnv.openFile",
        "title": "Abrir .env",
        "category": "Semáforo Env",
        "icon": "$(go-to-file)"
      },
      {
        "command": "semaforoEnv.pickFile",
        "title": "Escolher arquivo .env",
        "category": "Semáforo Env",
        "icon": "$(folder-opened)"
      },
      {
        "command": "semaforoEnv.createExample",
        "title": "Criar .env.example de exemplo",
        "category": "Semáforo Env"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "semaforoEnv.openFile",
          "when": "view == semaforoEnv.view",
          "group": "navigation@1"
        },
        {
          "command": "semaforoEnv.pickFile",
          "when": "view == semaforoEnv.view",
          "group": "navigation@2"
        },
        {
          "command": "semaforoEnv.refresh",
          "when": "view == semaforoEnv.view",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "semaforoEnv.selectOption",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Semáforo Env",
      "properties": {
        "semaforoEnv.file": {
          "type": "string",
          "default": ".env",
          "description": "Caminho do arquivo controlado, relativo à primeira pasta do workspace. Se não for definido e não existir .env na raiz, a extensão usa o único .env encontrado em subpastas."
        },
        "semaforoEnv.showRestartHint": {
          "type": "boolean",
          "default": true,
          "description": "Mostra o lembrete para reiniciar o servidor depois de trocar o perfil."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/parser.test.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
